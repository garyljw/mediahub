# Copy to .env.local (dev) or to the installed mediahub.env (Windows service, see the README) and fill in real values.
# NEVER commit real values. This file must only ever contain placeholders.

# Radarr and Sonarr connections (URL and API key) are not set here.
# An admin adds them in MediaHub under Settings -> Connections.

# Session signing secret (optional). When unset, MediaHub generates one and stores it in its database
# (DATABASE_PATH below), so keep that file as private as this one.
# Setting it overrides the stored one. Changing it signs everyone out. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Public URL people use to reach MediaHub (used for cookies/CSRF origin checks)
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite database lives
DATABASE_PATH=./data/mediahub.db

# Time zone for times shown in MediaHub (IANA name, e.g. Europe/London or America/New_York)
DISPLAY_TIMEZONE=Europe/London

# Overnight updates on Windows: MediaHub checks GitHub between 03:00 and 04:00 (PC time) and installs a newer
# signed release. Set to false to turn that off. Blank means true. Manual installs always work.
# MEDIAHUB_AUTO_UPDATE=true

# Set by the Windows service config, not here: the updater's folder, where the launcher looks for a request to
# restore the database after a rolled-back update.
# MEDIAHUB_UPDATES_DIR=

# Where the packaged app listens (npm run package / npm start). npm run dev always uses port 3000.
# MEDIAHUB_HOST=0.0.0.0
# MEDIAHUB_PORT=7979
