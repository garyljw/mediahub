# Copy to .env.local (dev) or the NAS .env file (prod) and fill in real values.
# NEVER commit real values. This file must only ever contain placeholders.

# Radarr (Settings -> General -> API Key)
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# Sonarr (Settings -> General -> API Key)
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL people use to reach MediaHub (used for cookies/CSRF origin checks)
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite database lives
DATABASE_PATH=./data/mediahub.db
