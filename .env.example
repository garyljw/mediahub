# Copy to .env.local (dev) or the NAS .env file (prod) and fill in real values.
# NEVER commit real values. This file must only ever contain placeholders.

# Radarr and Sonarr connections (URL and API key) are not set here.
# An admin adds them in MediaHub under Settings -> Connections.

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL people use to reach MediaHub (used for cookies/CSRF origin checks)
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite database lives
DATABASE_PATH=./data/mediahub.db

# Time zone for times shown in MediaHub (IANA name, e.g. Europe/London or America/New_York)
DISPLAY_TIMEZONE=Europe/London
