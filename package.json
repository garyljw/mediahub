{
  "name": "mediahub",
  "version": "1.8.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "package": "next build && node scripts/package.mjs",
    "start": "node --env-file-if-exists=.env.local dist/mediahub/mediahub.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "gen:arr": "node scripts/gen-arr.mjs",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "create-user": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-user.ts",
    "create-admin": "npm run create-user -- --role admin",
    "reset-plex-admin": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reset-plex-admin.ts",
    "demo": "tsx scripts/demo/run.ts",
    "demo:screenshots": "tsx scripts/demo/run.ts --screenshots",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "smartcrop": "2.0.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "license": "MIT"
}
