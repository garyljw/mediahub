<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: the installer replaces @APP@ (install folder) and @DATA@ (C:\ProgramData\MediaHub) and registers the task as MediaHub\Updater. It runs every minute (stage 1). -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Checks GitHub for MediaHub updates and installs a newer signed release.</Description>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT1M</Interval>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <LogonType>ServiceAccount</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <!-- Stage 1 only checks and downloads: the install runs in MediaHub\UpdateInstall. -->
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>@APP@\node.exe</Command>
      <Arguments>--env-file="@DATA@\mediahub.env" "@APP@\app\tools\updater.mjs" --app-dir "@APP@" --data-dir "@DATA@"</Arguments>
    </Exec>
  </Actions>
</Task>
